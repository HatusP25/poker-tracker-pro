# Production Environment Variables Template
# Copy this to .env.production and fill in actual values

# Database - Provided by Railway PostgreSQL Plugin
# Railway will automatically set this via ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://user:password@host:port/database?schema=public"

# Server Configuration
PORT=3001
NODE_ENV=production

# CORS - Railway provides this via ${{RAILWAY_PUBLIC_DOMAIN}}
# Use your Railway subdomain: https://your-app.up.railway.app
CORS_ORIGIN=https://your-app.railway.app

# Shared secret gating every mutating request (POST/PATCH/PUT/DELETE).
# REQUIRED in production: without it, anyone who finds this URL can call
# POST /api/backup/import with mode:"replace" and delete your data. CORS does
# not stop this — it only constrains browsers, not curl. See docs/SECURITY.md.
#
# The SAME value must be built into the client as VITE_API_KEY, or the app will
# 401 against its own API. Roll it out in this order:
#   1. deploy with API_KEY unset, set VITE_API_KEY, confirm the header is sent
#   2. then set API_KEY to the same value
# Generate one with: openssl rand -hex 32
API_KEY=
VITE_API_KEY=

# Optional: Connection Pooling
DATABASE_CONNECTION_LIMIT=10
DATABASE_POOL_TIMEOUT=60

# Optional: Prisma Logging in Production
# PRISMA_LOG_LEVEL=info

# Optional: Error Tracking (e.g., Sentry)
# SENTRY_DSN=your-sentry-dsn
