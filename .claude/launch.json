{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "poker-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "poker-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:server"
      ],
      "port": 3001,
      "autoPort": false
    },
    {
      "name": "poker-client",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd client && npx vite --port 5199 --strictPort"
      ],
      "port": 5199,
      "autoPort": false
    }
  ]
}
